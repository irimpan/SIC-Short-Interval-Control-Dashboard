///$tab Main
// ============================================================================
// SIC - Short Interval Control : demo load script (step 2 - dashboard app)
// Demo script prepared with AI assistance, based on a live system I designed and built.
// ----------------------------------------------------------------------------
// Rebuilt for this portfolio using SIMULATED data (see /data).
// In the live version, the same structure is fed from:
//   - machine sensors (run / stop signals)      -> sensor_machine_events
//   - line pack counters (hourly counts)         -> counter_pack_counts_hourly
//   - ERP (orders, products, standards, costs)   -> erp_production_orders, dim_product
//
// Two-step QVD architecture, as in the live app:
//   1. SIC_01_extract_to_qvd.qvs  - source data -> QVD files
//   2. this script                - QVD files   -> data model
//
// To run: run the extract script first to create the QVDs, then paste this
// script into the dashboard app and reload.
// ============================================================================

SET ThousandSep=',';
SET DecimalSep='.';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss';
SET DateFormat='YYYY-MM-DD';
SET vQvd = 'lib://SIC_Demo/QVD/';     // QVD layer (created by SIC_01_extract_to_qvd.qvs)


///$tab Dimensions
// ---------------------------------------------------------------------------
// Lines, products (with ERP standards and cost), downtime reasons
// ---------------------------------------------------------------------------
Line:
LOAD
    LineID,
    LineName,
    Area,
    CrewSize
FROM [$(vQvd)dim_line.qvd] (qvd);

Product:
LOAD
    ProductCode,
    ProductName,
    PackWeight_g,
    StdPacksPerHour,
    CostPerPack_GBP
FROM [$(vQvd)dim_product.qvd] (qvd);

DowntimeReason:
LOAD
    ReasonCode,
    ReasonName,
    ReasonType
FROM [$(vQvd)dim_downtime_reason.qvd] (qvd);

// Order -> product lookup (ERP)
Map_OrderProduct:
MAPPING LOAD
    OrderNo,
    ProductCode
FROM [$(vQvd)erp_production_orders.qvd] (qvd);

Map_StdRate:
MAPPING LOAD ProductCode, StdPacksPerHour RESIDENT Product;

Map_Cost:
MAPPING LOAD ProductCode, CostPerPack_GBP RESIDENT Product;


///$tab Downtime
// ---------------------------------------------------------------------------
// Sensor stop events can span several hours.
// Split each stop into hourly slices so downtime lines up with the hourly
// pack counts (e.g. a stop from 10:40 to 11:25 = 20 min in 10:00, 25 min in 11:00).
// ---------------------------------------------------------------------------
StopEvents_Raw:
LOAD
    EventID,
    LineID,
    Timestamp#(StartTime, 'YYYY-MM-DD hh:mm:ss') AS StopStart,
    Timestamp#(EndTime,   'YYYY-MM-DD hh:mm:ss') AS StopEnd,
    ReasonCode,
    MachineState
FROM [$(vQvd)sensor_machine_events.qvd] (qvd)
WHERE MachineState = 'STOP';

DowntimeSlices:
LOAD
    EventID,
    LineID,
    ReasonCode,
    HourStart,
    LineID & '|' & Text(Timestamp(HourStart, 'YYYY-MM-DD hh:mm:ss')) AS %LineHourKey,
    Round( ( RangeMin(StopEnd, HourStart + 1/24) - RangeMax(StopStart, HourStart) ) * 1440, 0.01 ) AS DowntimeMins;
LOAD
    EventID,
    LineID,
    ReasonCode,
    StopStart,
    StopEnd,
    Timestamp( Round( Floor(StopStart, 1/24) + (IterNo() - 1) / 24, 1/1440 ) ) AS HourStart
RESIDENT StopEvents_Raw
WHILE Floor(StopStart, 1/24) + (IterNo() - 1) / 24 < StopEnd;

// Keep the original events for the stop log table (count of stops, longest stop)
StopEvents:
LOAD
    EventID,
    StopStart,
    StopEnd,
    Round( (StopEnd - StopStart) * 1440, 0.01 ) AS StopDurationMins
RESIDENT StopEvents_Raw;

DROP TABLE StopEvents_Raw;


///$tab Production
// ---------------------------------------------------------------------------
// Hourly pack counts from the line counters, enriched with ERP data.
// Night shift (22:00-06:00) belongs to the production day it started on.
// ---------------------------------------------------------------------------
Production_Hourly:
LOAD
    *,
    GoodPacks * CostPerPack_GBP          AS GoodValue_GBP,
    RejectedPacks * CostPerPack_GBP      AS WasteCost_GBP,
    StdPacksPerHour                      AS TargetPacks;       // 1 hour of standard output
LOAD
    LineID & '|' & Text(Timestamp(HourStart, 'YYYY-MM-DD hh:mm:ss')) AS %LineHourKey,
    LineID,
    OrderNo,
    ApplyMap('Map_OrderProduct', OrderNo, 'Unknown')                         AS ProductCode,
    ApplyMap('Map_StdRate', ApplyMap('Map_OrderProduct', OrderNo), 0)        AS StdPacksPerHour,
    ApplyMap('Map_Cost',    ApplyMap('Map_OrderProduct', OrderNo), 0)        AS CostPerPack_GBP,
    HourStart,
    Hour(HourStart)                                                          AS Hour,
    Date(Floor(HourStart - 6/24))                                            AS ProductionDate,
    If(Hour(HourStart) >= 6 and Hour(HourStart) < 14, 'Early',
       If(Hour(HourStart) >= 14 and Hour(HourStart) < 22, 'Late', 'Night'))  AS Shift,
    GoodPacks,
    RejectedPacks
;
LOAD
    Timestamp#(HourStart, 'YYYY-MM-DD hh:mm:ss') AS HourStart,
    LineID,
    OrderNo,
    GoodPacks,
    RejectedPacks
FROM [$(vQvd)counter_pack_counts_hourly.qvd] (qvd);

// Remove the duplicate fields so the downtime slices link only on %LineHourKey
DROP FIELDS LineID, HourStart FROM DowntimeSlices;

// Product and line fields are already on Production_Hourly
DROP FIELDS StdPacksPerHour, CostPerPack_GBP FROM Product;


///$tab Calendar
// ---------------------------------------------------------------------------
// Simple production calendar
// ---------------------------------------------------------------------------
TempRange:
LOAD
    Min(ProductionDate) AS MinDate,
    Max(ProductionDate) AS MaxDate
RESIDENT Production_Hourly;

LET vMinDate = Num(Peek('MinDate', 0, 'TempRange'));
LET vMaxDate = Num(Peek('MaxDate', 0, 'TempRange'));
DROP TABLE TempRange;

ProductionCalendar:
LOAD
    Date($(vMinDate) + IterNo() - 1)                         AS ProductionDate,
    WeekDay($(vMinDate) + IterNo() - 1)                      AS Weekday,
    Week($(vMinDate) + IterNo() - 1)                         AS Week,
    Month($(vMinDate) + IterNo() - 1)                        AS Month,
    Year($(vMinDate) + IterNo() - 1)                         AS Year
AUTOGENERATE 1
WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);


///$tab Variables
// ---------------------------------------------------------------------------
// KPI expressions used on the SIC screens (also listed in measures.md)
// ---------------------------------------------------------------------------
SET vGoodPacks        = Sum(GoodPacks);
SET vTargetPacks      = Sum(TargetPacks);
SET vDowntimeMins     = Sum(DowntimeMins);
SET vAvailableMins    = Count(DISTINCT %LineHourKey) * 60;
SET vAttainment       = Sum(GoodPacks) / Sum(TargetPacks);
SET vAvailability     = 1 - Sum(DowntimeMins) / (Count(DISTINCT %LineHourKey) * 60);
SET vWastePct         = Sum(RejectedPacks) / (Sum(GoodPacks) + Sum(RejectedPacks));
SET vWasteCost        = Sum(WasteCost_GBP);
SET vPacksPerLabourHr = Sum(GoodPacks) / Sum(Aggr(Only(CrewSize), %LineHourKey));
